#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$HERE/.." && pwd)
if ! command -v node >/dev/null 2>&1; then
  echo "Werkforce Starter needs Node.js 20 or newer. Install Node.js, then run this command again." >&2
  exit 2
fi
exec node "$ROOT/kernel/dist/werkforce-kernel.mjs" "$@"
